<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12100E">

    <ImageView
        android:id="@+id/recommendationImage"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/ic_recommend"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/recommendationName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Elixir"
        android:textColor="#C6A664"
        android:textSize="26sp"
        android:fontFamily="serif"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/recommendationImage"
        app:layout_constraintStart_toEndOf="@id/recommendationImage"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="12dp"/>

    <LinearLayout
        android:id="@+id/bodySection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/recommendationImage"
        app:layout_constraintBottom_toTopOf="@id/bottomNavFragmentContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView style="@style/DetailItem" android:text="Type: Vitalizing" />
        <TextView style="@style/DetailItem" android:text="Origin: Elven Woods" />
        <TextView style="@style/DetailItem" android:text="Flavor: Sweet, Herbal" />
        <TextView style="@style/DetailItem" android:text="Effects: Healing, Energy" />
        <TextView style="@style/DetailItem" android:text="Caffeine: ★★☆☆☆" />
        <TextView style="@style/DetailItem" android:text="Common Uses: Morning Brew" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A perfect mixture of medicinal herbs and coffee beans."
            android:textColor="#F2EAD3"
            android:fontFamily="serif"
            android:layout_marginTop="12dp"/>
        <Button
            android:id="@+id/orderButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#7A9E7E"
            android:textColor="#12100E"
            android:text="Order"
            android:fontFamily="serif"
            android:textStyle="bold"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_launcher_foreground"
        app:tint="#C6A664"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/bottomNavFragmentContainer"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:name="com.example.thehealershearth.ui.fragments.BottomNavFragment"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
