<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#1B1815"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="10">

        <ImageView
            android:id="@+id/recommendationImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="7"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_ingredient"/>

        <TextView
            android:id="@+id/recommendationTitle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Elixir"
            android:textColor="#C6A664"
            android:textSize="16sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="4dp"/>

        <TextView
            android:id="@+id/recommendationDesc"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Vitalizing brew"
            android:textColor="#F2EAD3"
            android:textSize="12sp"
            android:fontFamily="serif"
            android:gravity="center"
            android:paddingHorizontal="4dp"/>

        <Button
            android:id="@+id/recommendationButton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:backgroundTint="#7A9E7E"
            android:textColor="#12100E"
            android:text="Details"
            android:textSize="10sp"
            android:padding="0dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
