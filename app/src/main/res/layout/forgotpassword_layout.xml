<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12100E">

    <!-- FORGOT PASSWORD CARD -->
    <LinearLayout
        android:id="@+id/forgotCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#1B1815"
        android:layout_margin="24dp"
        android:gravity="center_horizontal"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo/Icon -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_grimoire"
            android:layout_marginBottom="16dp"
            app:tint="#C6A664" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FORGOT PASSWORD"
            android:textColor="#C6A664"
            android:textSize="20sp"
            android:fontFamily="serif"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp"/>

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your email to receive a\nrestorative ritual code"
            android:textColor="#F2EAD3"
            android:textSize="14sp"
            android:fontFamily="serif"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Healer Email"
            android:padding="12dp"
            android:textColor="#F2EAD3"
            android:textColorHint="#8A7F6A"
            android:background="#231F1B"
            android:layout_marginBottom="12dp"/>

        <!-- Code (Hidden or initially empty) -->
        <EditText
            android:id="@+id/etCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ritual Code"
            android:padding="12dp"
            android:textColor="#F2EAD3"
            android:textColorHint="#8A7F6A"
            android:background="#231F1B"
            android:layout_marginBottom="20dp"
            android:visibility="gone"/>

        <!-- SEND CODE BUTTON -->
        <Button
            android:id="@+id/btnSendCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="SEND RITUAL CODE"
            android:textColor="#12100E"
            android:backgroundTint="#C6A664"
            android:fontFamily="serif"
            android:layout_marginBottom="16dp"/>

        <!-- BACK BUTTON -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Return to Login"
            android:textColor="#7A9E7E"
            android:textSize="14sp"
            android:fontFamily="serif"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>